@model IEnumerable<CoworkingCenter.Models.Booking>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-dark fw-bold">Архив бронирований</h2>
</div>

<div class="table-responsive shadow-sm rounded-3">
    <table class="table table-hover table-striped bg-white">
        <thead class="table-dark">
        <tr>
            <th class="ps-4">Дата</th>
            <th>Время</th>
            <th>Резидент (ФИО)</th>
            <th>Рабочее место</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="ps-4">@item.Date.ToString("dd.MM.yyyy")</td>
                <td class="font-monospace">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                <td class="fw-bold">@(item.Resident != null ? item.Resident.Name : "Посетитель")</td>
                <td>@item.WorkplaceId</td>
            </tr>
        }
        </tbody>
    </table>
</div>

<!-- ВИЗУАЛЬНЫЙ БЛОК ПЕРЕКЛЮЧЕНИЯ СТРАНИЦ (ПАГИНАЦИЯ) -->
<div class="d-flex justify-content-center mt-4">
    <nav>
        <ul class="pagination" style="display: flex; list-style: none; gap: 5px;">
            @if (ViewBag.CurrentPage > 1)
            {
                <li><a href="/Bookings?page=@(ViewBag.CurrentPage - 1)" class="btn btn-secondary btn-sm">◀ Назад</a></li>
            }
            
            <li class="btn btn-light btn-sm disabled">Страница @ViewBag.CurrentPage из @ViewBag.TotalPages</li>

            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li><a href="/Bookings?page=@(ViewBag.CurrentPage + 1)" class="btn btn-primary btn-sm">Вперед ▶</a></li>
            }
        </ul>
    </nav>
</div>