@model CoworkingCenter.Models.Resident

<h2 class="text-dark fw-bold">👤 Оформление нового резидента</h2>
<hr />

<div class="card p-4 bg-white border-0 shadow-sm rounded-3 col-md-6">
    <form action="/Residents/Create" method="post">
        <div class="mb-3">
            <label class="form-label fw-semibold">ФИО / Название компании</label>
            <input name="Name" class="form-control" placeholder="Иванов Иван Иванович или ООО 'Вектор'" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Контакты (Телефон / Email)</label>
            <input name="Contacts" class="form-control" placeholder="+375 (29) 123-45-67" required />
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Тарифный план (Абонемент)</label>
            <select name="Tariff" class="form-control" required>
                <option value="Базовый">Базовый тариф</option>
                <option value="Стандарт">Стандартный тариф</option>
                <option value="Безлимит">Безлимит (Все включено)</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label fw-semibold">Дата окончания тарифа</label>
            <input name="TariffEndDate" type="date" class="form-control" value="@DateTime.Today.AddMonths(1).ToString("yyyy-MM-dd")" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-success px-4 me-2">Сохранить</button>
            <a href="/Residents" class="btn btn-secondary px-4">Назад к списку</a>
        </div>
    </form>
</div>