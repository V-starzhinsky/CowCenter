@model IEnumerable<CoworkingCenter.Models.Resident>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-dark fw-bold">📋 Резиденты и их активные бронирования</h2>
    <a href="/Residents/Create" class="btn btn-primary px-4 shadow-sm">+ Добавить резидента</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card text-center p-5 bg-white border-0 shadow-sm rounded-3">
        <div class="card-body">
            <h4 class="text-muted mb-3">В базе данных пока нет ни одного резидента</h4>
            <a href="/Residents/Create" class="btn btn-outline-primary btn-lg">Оформить первого резидента</a>
        </div>
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-hover table-striped align-middle mb-0 bg-white">
            <thead class="table-dark">
                <tr>
                    <th class="ps-4">ФИО / Компания</th>
                    <th>Контакты</th>
                    <th>Тариф</th>
                    <th>Активные бронирования столов/кабинетов</th>
                    <th class="text-end pe-4">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var resident in Model)
                {
                    <tr>
                        <td class="fw-semibold ps-4">@resident.Name</td>
                        <td>@resident.Contacts</td>
                        <td><span class="badge bg-secondary">@resident.Tariff</span></td>
                        
                        <!-- ВЫВОД АКТИВНЫХ БРОНИРОВАНИЙ -->
                        <td>
                            @{
                                // Используем имя переменной resident, которая объявлена в цикле foreach выше!
                                var activeBookings = resident.Bookings
                                    .Where(b => b.Date >= DateTime.Today)
                                    .OrderBy(b => b.Date)
                                    .ToList();
                            }

                            @if (activeBookings.Any())
                            {
                                <div style="max-height: 150px; overflow-y: auto;">
                                    @foreach (var b in activeBookings)
                                    {
                                        <div class="small mb-1 p-2 bg-light rounded border shadow-none">
                                            📅 <strong>@b.Date.ToString("dd.MM.yyyy")</strong> 
                                            (⏱ @b.StartTime.ToString(@"hh\:mm") - @b.EndTime.ToString(@"hh\:mm"))
                                            <br />
                                            <span class="text-secondary small">📍 Размещение:</span>
                                            @if (b.Workplace != null)
                                            {
                                                if (b.Workplace.Type == "Флекс")
                                                {
                                                    <span class="badge bg-success">🔄 Флекс (Любой свободный)</span>
                                                }
                                                else if (b.Workplace.Type == "Офис")
                                                {
                                                    <span class="badge bg-danger">🏢 @b.Workplace.TableNumber</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">📌 @b.Workplace.TableNumber</span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">Не указано</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted small">Нет активных броней</span>
                            }
                        </td>

                        <td class="text-end pe-4">
                            <a href="/Residents/Details/@resident.Id" class="btn btn-info btn-sm text-white me-1">⏱️ Часы</a>
                            <a href="/Residents/Edit/@resident.Id" class="btn btn-warning btn-sm me-1">✏️ Изменить</a>
                            <a href="/Residents/Delete/@resident.Id" class="btn btn-danger btn-sm" onclick="return confirm('Удалить резидента?')">❌ Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<!-- Блок переключения страниц для Резидентов -->
<div class="d-flex justify-content-center mt-4">
    <nav>
        <ul class="pagination" style="display: flex; list-style: none; gap: 5px;">
            @if (ViewBag.CurrentPage > 1)
            {
                <li><a href="/Residents?page=@(ViewBag.CurrentPage - 1)" class="btn btn-secondary btn-sm">◀ Назад</a></li>
            }
            <li class="btn btn-light btn-sm disabled fw-bold">Страница @ViewBag.CurrentPage из @ViewBag.TotalPages</li>
            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <li><a href="/Residents?page=@(ViewBag.CurrentPage + 1)" class="btn btn-primary btn-sm">Вперед ▶</a></li>
            }
        </ul>
    </nav>
</div>
